execute_process(COMMAND "${AUTHENTIC_DIGEST}" OUTPUT_VARIABLE authentic_out RESULT_VARIABLE authentic_rc)
execute_process(COMMAND "${ENHANCED_DIGEST}" OUTPUT_VARIABLE enhanced_out RESULT_VARIABLE enhanced_rc)

if(NOT authentic_rc EQUAL 0 OR NOT enhanced_rc EQUAL 0)
    message(FATAL_ERROR "digest exited with authentic=${authentic_rc} enhanced=${enhanced_rc}")
endif()

if(NOT authentic_out STREQUAL enhanced_out)
    string(REPLACE "\n" ";" authentic_lines "${authentic_out}")
    string(REPLACE "\n" ";" enhanced_lines "${enhanced_out}")
    list(LENGTH authentic_lines count)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        list(GET authentic_lines ${i} a)
        list(LENGTH enhanced_lines enhanced_count)
        set(e "<missing>")
        if(i LESS enhanced_count)
            list(GET enhanced_lines ${i} e)
        endif()
        if(NOT a STREQUAL e)
            message(FATAL_ERROR "Authentic edition diverges from authentic library at line ${i}:\n  authentic: ${a}\n  enhanced:  ${e}")
        endif()
    endforeach()
    message(FATAL_ERROR "Authentic edition output differs from authentic library")
endif()

string(REGEX MATCHALL "\n" lines "${authentic_out}")
list(LENGTH lines line_count)
message(STATUS "parity OK (${line_count} checkpoints)")
